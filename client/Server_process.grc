options:
  parameters:
    author: Dramco_Tianzheng
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Server
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Server_process
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\nfrom collections\
      \ import deque\nimport time\nimport os\n\n# ====== \u5173\u952E\uFF1A\u8BA9\
      \ GRC \u751F\u6210\u7AEF\u53E3 ======\nin_sig = None\nout_sig = None\nin_msg\
      \ = ['raw', 'dec']                 # \u4E24\u8DEF\u8F93\u5165\uFF1Araw / dec\n\
      out_msg = ['stat', 'raw_out', 'dec_out']  # \u4E09\u8DEF\u8F93\u51FA\uFF1A\u7EDF\
      \u8BA1 + \u4E24\u8DEF\u8F6C\u53D1\n# ===================================\n\n\
      \nclass blk(gr.sync_block):\n    \"\"\"\n    Server-side PDU comparator (no\
      \ GUI):\n    - Input:  raw / dec PDUs (u8vector payload; usually bits 0/1)\n\
      \    - Output: stat PDU (metadata only), raw_out PDU, dec_out PDU\n    - Alignment:\n\
      \        * Prefer seq in metadata: seq/frame_id/pkt_id/id\n        * Otherwise\
      \ FIFO alignment\n    \"\"\"\n\n    def __init__(self,\n                 print_every=50,\n\
      \                 forward_every=10,\n                 max_pending=200,\n   \
      \              csv_path=\"\"):\n        gr.sync_block.__init__(\n          \
      \  self,\n            name=\"Message Comparator (PDU bits) - server\",\n   \
      \         in_sig=None,\n            out_sig=None\n        )\n\n        # ----\
      \ params ----\n        self.print_every = int(print_every)          # \u6BCF\
      \u591A\u5C11\u5E27\u6253\u5370\u4E00\u6B21\u7EDF\u8BA1\n        self.forward_every\
      \ = int(forward_every)      # \u6BCF\u591A\u5C11\u5E27\u8F6C\u53D1\u4E00\u6B21\
      \ raw/dec \u5230 PC\n        self.max_pending = int(max_pending)          #\
      \ \u7F13\u5B58\u4E0A\u9650\u9632\u7206\u5185\u5B58\n        self.csv_path =\
      \ str(csv_path).strip()\n\n        # ---- ports ----\n        # inputs\n   \
      \     self.message_port_register_in(pmt.intern(\"raw\"))\n        self.message_port_register_in(pmt.intern(\"\
      dec\"))\n        self.set_msg_handler(pmt.intern(\"raw\"), self._handle_raw)\n\
      \        self.set_msg_handler(pmt.intern(\"dec\"), self._handle_dec)\n\n   \
      \     # outputs\n        self.message_port_register_out(pmt.intern(\"stat\"\
      ))\n        self.message_port_register_out(pmt.intern(\"raw_out\"))\n      \
      \  self.message_port_register_out(pmt.intern(\"dec_out\"))\n\n        # ----\
      \ buffers ----\n        # seq \u5BF9\u9F50\uFF1A\u7F13\u5B58\u539F\u59CB msg\
      \ + payload array\n        self.raw_map = {}   # seq -> (msg, payload_u8)\n\
      \        self.dec_map = {}   # seq -> (msg, payload_u8)\n\n        # \u65E0\
      \ seq\uFF1AFIFO\n        self.raw_fifo = deque()  # items: (msg, payload_u8)\n\
      \        self.dec_fifo = deque()\n\n        # ---- stats ----\n        self.frames\
      \ = 0\n        self.total_bits = 0\n        self.total_errs = 0\n        self.len_mismatch\
      \ = 0\n        self.last_print_t = time.time()\n\n        # ---- csv logging\
      \ (optional) ----\n        self._csv_fh = None\n        if self.csv_path:\n\
      \            # \u5982\u679C\u76EE\u5F55\u4E0D\u5B58\u5728\u5C3D\u91CF\u521B\u5EFA\
      \n            d = os.path.dirname(self.csv_path)\n            if d and (not\
      \ os.path.exists(d)):\n                os.makedirs(d, exist_ok=True)\n     \
      \       self._csv_fh = open(self.csv_path, \"a\", buffering=1)\n           \
      \ # \u5982\u679C\u6587\u4EF6\u662F\u7A7A\u7684\uFF0C\u5199\u8868\u5934\n   \
      \         if self._csv_fh.tell() == 0:\n                self._csv_fh.write(\"\
      timestamp,frames,bits,errs,ber,len_mismatch\\n\")\n\n    # ----------------\
      \ utilities ----------------\n    def _pdu_to_u8(self, msg):\n        \"\"\"\
      Return (meta_dict, np.uint8 payload) or (None, None).\"\"\"\n        if not\
      \ pmt.is_pair(msg):\n            return None, None\n        meta = pmt.car(msg)\n\
      \        data = pmt.cdr(msg)\n\n        try:\n            vec = pmt.u8vector_elements(data)\n\
      \        except Exception:\n            return None, None\n\n        meta_dict\
      \ = {}\n        if pmt.is_dict(meta):\n            try:\n                meta_dict\
      \ = pmt.to_python(meta)\n            except Exception:\n                meta_dict\
      \ = {}\n        return meta_dict, np.frombuffer(bytes(vec), dtype=np.uint8)\n\
      \n    def _get_seq(self, meta_dict):\n        \"\"\"Try to extract sequence\
      \ id from metadata.\"\"\"\n        for k in (\"seq\", \"frame_id\", \"pkt_id\"\
      , \"id\"):\n            if k in meta_dict:\n                try:\n         \
      \           return int(meta_dict[k])\n                except Exception:\n  \
      \                  return None\n        return None\n\n    def _trim_pending(self):\n\
      \        \"\"\"Avoid unbounded growth.\"\"\"\n        while len(self.raw_map)\
      \ > self.max_pending:\n            self.raw_map.pop(next(iter(self.raw_map)))\n\
      \        while len(self.dec_map) > self.max_pending:\n            self.dec_map.pop(next(iter(self.dec_map)))\n\
      \n        while len(self.raw_fifo) > self.max_pending:\n            self.raw_fifo.popleft()\n\
      \        while len(self.dec_fifo) > self.max_pending:\n            self.dec_fifo.popleft()\n\
      \n    def _publish_stat(self):\n        \"\"\"Publish a metadata-only PDU on\
      \ 'stat'.\"\"\"\n        ber = (self.total_errs / self.total_bits) if self.total_bits\
      \ > 0 else 0.0\n        meta = pmt.make_dict()\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"frames\"), pmt.from_long(self.frames))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"bits\"), pmt.from_long(self.total_bits))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"errs\"), pmt.from_long(self.total_errs))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"ber\"), pmt.from_double(float(ber)))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern(\"len_mismatch\"), pmt.from_long(self.len_mismatch))\n        meta\
      \ = pmt.dict_add(meta, pmt.intern(\"ts\"), pmt.from_double(time.time()))\n\n\
      \        pdu = pmt.cons(meta, pmt.init_u8vector(0, []))\n        self.message_port_pub(pmt.intern(\"\
      stat\"), pdu)\n\n        # optional CSV\n        if self._csv_fh is not None:\n\
      \            self._csv_fh.write(f\"{time.time()},{self.frames},{self.total_bits},{self.total_errs},{ber},{self.len_mismatch}\\\
      n\")\n\n        # also print to server console\n        print(f\"[Comparator]\
      \ frames={self.frames}, bits={self.total_bits}, \"\n              f\"errs={self.total_errs},\
      \ BER={ber:.6e}, len_mismatch={self.len_mismatch}\")\n\n    def _compare_pair(self,\
      \ raw_item, dec_item, seq=None):\n        \"\"\"\n        raw_item/dec_item:\
      \ (msg, payload_u8)\n        Compare payloads; update stats; optionally forward\
      \ raw/dec PDUs to PC.\n        \"\"\"\n        raw_msg, raw_u8 = raw_item\n\
      \        dec_msg, dec_u8 = dec_item\n\n        n1, n2 = int(raw_u8.size), int(dec_u8.size)\n\
      \        if n1 != n2:\n            self.len_mismatch += 1\n            n = min(n1,\
      \ n2)\n            raw_u8 = raw_u8[:n]\n            dec_u8 = dec_u8[:n]\n  \
      \      else:\n            n = n1\n\n        errs = int(np.count_nonzero(raw_u8\
      \ != dec_u8))\n        self.frames += 1\n        self.total_bits += n\n    \
      \    self.total_errs += errs\n\n        # ---- forward raw/dec to PC (throttled)\
      \ ----\n        if self.forward_every > 0 and (self.frames % self.forward_every\
      \ == 0):\n            # \u539F\u6837\u8F6C\u53D1\u6536\u5230\u7684 PDU \u6700\
      \u7A33\uFF08\u4FDD\u7559 metadata/payload\uFF09\n            self.message_port_pub(pmt.intern(\"\
      raw_out\"), raw_msg)\n            self.message_port_pub(pmt.intern(\"dec_out\"\
      ), dec_msg)\n\n        # ---- publish stat periodically ----\n        if self.print_every\
      \ > 0 and (self.frames % self.print_every == 0):\n            self._publish_stat()\n\
      \n    # ---------------- handlers ----------------\n    def _handle_raw(self,\
      \ msg):\n        meta, raw_u8 = self._pdu_to_u8(msg)\n        if raw_u8 is None:\n\
      \            return\n\n        seq = self._get_seq(meta)\n        item = (msg,\
      \ raw_u8)\n\n        if seq is not None:\n            self.raw_map[seq] = item\n\
      \            if seq in self.dec_map:\n                dec_item = self.dec_map.pop(seq)\n\
      \                raw_item = self.raw_map.pop(seq)\n                self._compare_pair(raw_item,\
      \ dec_item, seq=seq)\n            self._trim_pending()\n        else:\n    \
      \        self.raw_fifo.append(item)\n            if len(self.dec_fifo) > 0:\n\
      \                dec_item = self.dec_fifo.popleft()\n                raw_item\
      \ = self.raw_fifo.popleft()\n                self._compare_pair(raw_item, dec_item,\
      \ seq=None)\n            self._trim_pending()\n\n    def _handle_dec(self, msg):\n\
      \        meta, dec_u8 = self._pdu_to_u8(msg)\n        if dec_u8 is None:\n \
      \           return\n\n        seq = self._get_seq(meta)\n        item = (msg,\
      \ dec_u8)\n\n        if seq is not None:\n            self.dec_map[seq] = item\n\
      \            if seq in self.raw_map:\n                raw_item = self.raw_map.pop(seq)\n\
      \                dec_item = self.dec_map.pop(seq)\n                self._compare_pair(raw_item,\
      \ dec_item, seq=seq)\n            self._trim_pending()\n        else:\n    \
      \        self.dec_fifo.append(item)\n            if len(self.raw_fifo) > 0:\n\
      \                raw_item = self.raw_fifo.popleft()\n                dec_item\
      \ = self.dec_fifo.popleft()\n                self._compare_pair(raw_item, dec_item,\
      \ seq=None)\n            self._trim_pending()\n\n    def stop(self):\n     \
      \   # \u5173\u95ED CSV\n        try:\n            if self._csv_fh is not None:\n\
      \                self._csv_fh.close()\n        except Exception:\n         \
      \   pass\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    csv_path: ''
    forward_every: '10'
    max_pending: '200'
    maxoutbuf: '0'
    minoutbuf: '0'
    print_every: '50'
  states:
    _io_cache: '(''Message Comparator (PDU bits) - server'', ''blk'', [(''print_every'',
      ''50''), (''forward_every'', ''10''), (''max_pending'', ''200''), (''csv_path'',
      "''''")], [(''dec'', ''message'', 1), (''raw'', ''message'', 1)], [(''dec_out'',
      ''message'', 1), (''raw_out'', ''message'', 1), (''stat'', ''message'', 1)],
      ''\n    Server-side PDU comparator (no GUI):\n    - Input:  raw / dec PDUs (u8vector
      payload; usually bits 0/1)\n    - Output: stat PDU (metadata only), raw_out
      PDU, dec_out PDU\n    - Alignment:\n        * Prefer seq in metadata: seq/frame_id/pkt_id/id\n        *
      Otherwise FIFO alignment\n    '', [''csv_path'', ''forward_every'', ''max_pending'',
      ''print_every''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 440.0]
    rotation: 0
    state: enabled
