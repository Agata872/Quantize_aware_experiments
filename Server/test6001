#!/usr/bin/env python3
import zmq, time

ctx = zmq.Context()
s = ctx.socket(zmq.PULL)
s.setsockopt(zmq.RCVTIMEO, 1000)  # 1s超时，方便判断有没有数据
s.connect("tcp://127.0.0.1:6001")  # 如果 probe 跑在 server 本机

count = 0
t0 = time.time()
while True:
    try:
        msg = s.recv()
    except zmq.Again:
        print("[probe] timeout: no data")
        continue
    count += 1
    if count % 50 == 0:
        dt = time.time() - t0
        print(f"[probe] got {count} messages, avg {count/dt:.1f} msg/s, last {len(msg)} bytes")
